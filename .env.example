# Provider order: selected provider first, then other configured providers on API failure.
CRYPTOPING_MODERATOR_PROVIDER=gemini
CRYPTOPING_MODERATOR_TIMEOUT_SECONDS=30

# Google Gemini API (free-tier access depends on model/project quotas).
GEMINI_API_KEY=
CRYPTOPING_MODERATOR_GEMINI_MODEL=gemini-3.1-flash-lite

# Groq API fallback.
GROQ_API_KEY=
CRYPTOPING_MODERATOR_GROQ_MODEL=openai/gpt-oss-20b

# Optional legacy OpenAI fallback. OpenAI API billing is separate from ChatGPT.
OPENAI_API_KEY=
CRYPTOPING_MODERATOR_MODEL=gpt-6-luna
